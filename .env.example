# Copier vers .env.local et renseigner les valeurs (jamais de secrets commites).

# Projet Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails transactionnels Resend (optionnel : sans cle, aucun email n'est envoye)
RESEND_API_KEY=
# Expediteur verifie ; laisser vide = sandbox onboarding@resend.dev (mode test)
RESEND_FROM=
